# Copy to .env and fill in. NEVER commit .env.
DB_NAME=cbt_exam
DB_USER=cbt
DB_PASS=change-me-to-a-long-random-string
DB_ROOT_PASSWORD=change-me-too-a-different-long-random-string

# First admin, created automatically on first start (only if no admin exists yet).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-at-least-10-chars

APP_PORT=8080
APP_TIMEZONE=Africa/Lagos

# Set to 1 once to load 3 sample Biology questions for a smoke test.
SEED_DEMO=0

# Production (docker-compose.prod.yml)
DOMAIN=exams.example.com
